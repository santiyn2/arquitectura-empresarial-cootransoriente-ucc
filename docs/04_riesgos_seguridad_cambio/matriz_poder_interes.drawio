        <mxCell id="node-s7" value="&lt;b&gt;S7&lt;/b&gt;&lt;br&gt;Pasajeros (Turistas/Est.)&lt;br&gt;(P:1, I:2)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c757d;fontColor=#ffffff;strokeColor=#545b62;fontSize=11;" vertex="1" parent="1">
