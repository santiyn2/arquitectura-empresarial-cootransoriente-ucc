  <diagram id="matriz-poder-interes" name="Matriz Poder-Interes Cootransoriente">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Background Card / Canvas -->
        <mxCell id="bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dee2e6;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="760" height="720" as="geometry" />
        </mxCell>
        
        <!-- Title -->
        <mxCell id="title" value="Matriz de Poder e Interés - Cootransoriente Tayrona (Fase 1 - Capa Estratégica)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;fontColor=#212529;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="680" height="30" as="geometry" />
        </mxCell>
        
        <!-- Subtitle Axis Y Label -->
        <mxCell id="y-label" value="NIVEL DE PODER (1 - 5)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=12;fontColor=#495057;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="10" y="380" width="160" height="30" as="geometry" />
        </mxCell>
        
        <!-- Subtitle Axis X Label -->
        <mxCell id="x-label" value="NIVEL DE INTERÉS (1 - 5)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=12;fontColor=#495057;" vertex="1" parent="1">
          <mxGeometry x="280" y="740" width="280" height="30" as="geometry" />
        </mxCell>
        
        <!-- QUADRANT III: Mantener informados (Low Power: 1-3, High Interest: 3-5) -> Bottom Left in Cartesian? Wait:
             Standard Power-Interest Grid:
             Y-axis: Power (Bottom = 1, Top = 5)
             X-axis: Interest (Left = 1, Right = 5)
             
             Let's set coordinates clearly:
             X range: 100 to 740 (Midpoint = 420)
             Y range: 120 to 680 (Midpoint = 400)
             
             In standard screen coordinates (Y goes down), let's map carefully:
             Top half (Y: 120 to 400) = HIGH POWER (4-5)
             Bottom half (Y: 400 to 680) = LOW POWER (1-3)
             Left half (X: 100 to 420) = LOW INTEREST (1-3)
             Right half (X: 420 to 740) = HIGH INTEREST (3-5)
             
             Let's review standard quadrants:
             - Top-Left (Low Interest, High Power): Mantener Satisfechos (S8, S9)
             - Top-Right (High Interest, High Power): Gestionar de Cerca (S1, S2)
             - Bottom-Left (Low Interest, Low Power): Monitorear (S7)
             - Bottom-Right (High Interest, Low Power): Mantener Informados (S3, S4, S5, S6)
        -->
        
        <!-- Q1 Top-Right: Gestionar de Cerca (High Power 4-5, High Interest 3-5) -->
        <mxCell id="q-gestionar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#c3e6cb;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="425" y="125" width="350" height="270" as="geometry" />
        </mxCell>
        <mxCell id="q1-title" value="I. GESTIONAR DE CERCA&#xa;(Alto Poder, Alto Interés)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#155724;" vertex="1" parent="1">
          <mxGeometry x="435" y="135" width="330" height="40" as="geometry" />
        </mxCell>
        
        <!-- Q2 Top-Left: Mantener Satisfechos (High Power 4-5, Low Interest 1-3) -->
        <mxCell id="q-satisfechos" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#b8daff;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="65" y="125" width="350" height="270" as="geometry" />
        </mxCell>
        <mxCell id="q2-title" value="II. MANTENER SATISFECHOS&#xa;(Alto Poder, Bajo Interés)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#004085;" vertex="1" parent="1">
          <mxGeometry x="75" y="135" width="330" height="40" as="geometry" />
        </mxCell>
        
        <!-- Q3 Bottom-Left: Monitorear (Low Power 1-3, Low Interest 1-3) -->
        <mxCell id="q-monitorear" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e3e5;strokeColor=#d6d8db;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="65" y="405" width="350" height="270" as="geometry" />
        </mxCell>
        <mxCell id="q3-title" value="IV. MONITOREAR&#xa;(Bajo Poder, Bajo Interés)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#383d41;" vertex="1" parent="1">
          <mxGeometry x="75" y="415" width="330" height="40" as="geometry" />
        </mxCell>
        
        <!-- Q4 Bottom-Right: Mantener Informados (Low Power 1-3, High Interest 3-5) -->
        <mxCell id="q-informados" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#ffeeba;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="425" y="405" width="350" height="270" as="geometry" />
        </mxCell>
        
        <mxCell id="q4-title" value="III. MANTENER INFORMADOS&#xa;(Bajo Poder, Alto Interés)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#856404;" vertex="1" parent="1">
          <mxGeometry x="435" y="415" width="330" height="40" as="geometry" />
        </mxCell>
        
        <!-- Center Dividing Axes -->
        <mxCell id="axis-v" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6c757d;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="420" y="680" as="sourcePoint" />
            <mxPoint x="420" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="axis-h" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6c757d;dashed=1;" edge="1" parent="1">
